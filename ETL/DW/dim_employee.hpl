    <sql>SELECT
  employee_id
, last_name
, first_name
, title
, title_of_courtesy
, DATE(birth_date) AS birth_date 
, DATE(hire_date) AS hire_date
, address
, city
, region
, postal_code
, country
, home_phone
, extension
, photo
, reports_to
, photo_path
FROM north.employee
</sql>
